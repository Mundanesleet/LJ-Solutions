---
/**
 * Stage for the hero sculpture. The WebGL canvas is mounted into [data-sculpture-canvas]
 * by Hero.astro's script; the SVG below is the fallback for devices without WebGL2,
 * with Save-Data, or with very little memory. It is also what visitors without JS see.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`sculpture ${className}`} data-sculpture aria-hidden="true">
  <div class="sculpture__canvas" data-sculpture-canvas></div>

  <svg class="sculpture__fallback" data-sculpture-fallback viewBox="0 0 600 600" fill="none">
    <defs>
      <radialGradient id="sc-glow" cx="50%" cy="48%" r="50%">
        <stop offset="0" stop-color="#ff4d00" stop-opacity="0.45"></stop>
        <stop offset="0.45" stop-color="#ff4d00" stop-opacity="0.12"></stop>
        <stop offset="1" stop-color="#ff4d00" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="sc-membrane" x1="90" y1="380" x2="500" y2="170" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#ff4d00" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="#cc3d00" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#ff4d00" stop-opacity="0.65"></stop>
      </linearGradient>
      <linearGradient id="sc-band" x1="140" y1="140" x2="470" y2="440" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#ff4d00"></stop>
        <stop offset="0.55" stop-color="#cc3d00" stop-opacity="0.75"></stop>
        <stop offset="1" stop-color="#0a0a0a" stop-opacity="0.4"></stop>
      </linearGradient>
      <linearGradient id="sc-band2" x1="160" y1="330" x2="470" y2="380" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#0a0a0a" stop-opacity="0.5"></stop>
        <stop offset="0.6" stop-color="#cc3d00" stop-opacity="0.8"></stop>
        <stop offset="1" stop-color="#ff4d00"></stop>
      </linearGradient>
      <filter id="sc-bloom" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
        <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
      </filter>
    </defs>

    <circle cx="300" cy="290" r="290" fill="url(#sc-glow)"></circle>

    <g class="sculpture__drift">
      <path
        d="M90 380C140 200 330 110 500 170C430 170 300 230 220 330C180 380 130 410 90 380Z"
        fill="url(#sc-membrane)"
        stroke="#ff4d00"
        stroke-opacity="0.35"></path>
      <path
        d="M140 250C240 120 420 130 470 250C500 330 440 430 340 440C380 400 410 330 380 280C340 210 240 200 140 250Z"
        fill="url(#sc-band)"
        stroke="#ff4d00"
        stroke-opacity="0.8"
        filter="url(#sc-bloom)"></path>
      <path
        d="M160 330C220 450 400 480 470 380C430 420 330 420 280 370C240 330 200 320 160 330Z"
        fill="url(#sc-band2)"
        stroke="#ff4d00"
        stroke-opacity="0.7"></path>
      <path
        d="M120 300C200 180 360 160 430 220S470 400 330 410 170 360 210 280 380 240 420 320"
        stroke="#ff4d00"
        stroke-width="2"
        stroke-linecap="round"
        filter="url(#sc-bloom)"></path>
    </g>
  </svg>
</div>

<style>
  .sculpture {
    position: relative;
    aspect-ratio: 1;
  }

  .sculpture__canvas {
    position: absolute;
    inset: 0;
  }

  .sculpture__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sculpture__fallback[hidden] {
    display: none;
  }

  .sculpture__drift {
    transform-origin: 300px 300px;
    animation: sculpture-drift 18s ease-in-out infinite alternate;
  }

  @keyframes sculpture-drift {
    from {
      transform: rotate(-4deg) translateY(6px);
    }
    to {
      transform: rotate(5deg) translateY(-8px);
    }
  }
</style>
