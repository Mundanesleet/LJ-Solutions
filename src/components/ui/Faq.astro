---
/**
 * FAQ section shared by the three service pages (Stitch "Preguntas frecuentes").
 * Left: eyebrow, title, intro and a WhatsApp link. Right: an accordion of native
 * <details> elements — keyboard and screen-reader friendly without JS. Items share
 * a `name`, so opening one closes the others; the first starts open, as designed.
 * Each page passes its own questions; the FAQPage structured data is emitted here.
 */
import Icon from './Icon.astro';
import { getWhatsAppLink } from '../../data/site';
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  intro: string;
  items: { q: string; a: string }[];
  /** Prefilled WhatsApp message for "¿Tienes otra pregunta? Hablemos". */
  whatsappMessage?: string;
  id?: string;
}

const { intro, items, whatsappMessage, id = 'faq' } = Astro.props;
const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).faq;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<section id={id} class="border-t border-white/5 bg-ink py-20 lg:py-28" aria-labelledby={`${id}-title`}>
  <div class="container-page grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:col-span-5">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id={`${id}-title`} class="text-h1-sm text-cream lg:text-h1">{t.title}</h2>
      <p class="max-w-md text-body text-cream/70">{intro}</p>
      <a
        href={getWhatsAppLink(lang, whatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-fit items-center gap-2 text-label text-orange transition-colors hover:text-cream"
      >
        <Icon name="contact_support" class="size-[18px]" />
        {t.more}
      </a>
    </div>

    <div class="flex flex-col gap-3 lg:col-span-7">
      {
        items.map(({ q, a }, i) => (
          <details class="faq-item group rounded-2xl bg-surface-1" name={`${id}-group`} open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-5 text-h3 text-cream sm:p-6">
              <span>{q}</span>
              <Icon name="expand_more" class="size-5 text-cream/60 transition-transform duration-300 group-open:rotate-180" />
            </summary>
            <p class="px-5 pb-5 text-body leading-relaxed text-cream/70 sm:px-6 sm:pb-6">{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
