---
/**
 * Labelled form control (Stitch contact form): uppercase label, required mark or
 * "(Opcional)" tag, dark inset input, and an error line that validation fills in.
 * The error is linked through aria-describedby and announced politely.
 */
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  rows?: number;
  maxlength?: number;
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  placeholder,
  autocomplete,
  rows = 5,
  maxlength,
  class: className = '',
} = Astro.props;

const t = useTranslations(toLocale(Astro.currentLocale)).form;
const id = `field-${name}`;
const errorId = `${id}-error`;
const control =
  'w-full rounded-xl border border-transparent bg-ink px-4 py-3.5 text-body text-cream placeholder:text-cream/30 transition-colors focus:border-orange/60 focus:outline-none aria-[invalid=true]:border-orange';
---

<div class:list={['flex flex-col gap-2', className]} data-field>
  <label for={id} class="flex items-center justify-between gap-3 text-label-md uppercase text-cream">
    <span>{label}</span>
    {
      required ? (
        <span class="text-orange" aria-hidden="true">*</span>
      ) : (
        <span class="normal-case tracking-normal text-cream/60">{t.optional}</span>
      )
    }
  </label>
  {
    type === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        maxlength={maxlength}
        aria-describedby={errorId}
        class:list={[control, 'min-h-32 resize-y']}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        maxlength={maxlength}
        aria-describedby={errorId}
        class={control}
      />
    )
  }
  <p id={errorId} class="min-h-5 text-body-sm text-orange empty:min-h-0" aria-live="polite" data-field-error></p>
</div>
