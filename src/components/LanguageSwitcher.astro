---
// Links to the same page in the other language. Slugs differ per language
// (/servicios/agentes-ia/ ↔ /en/services/ai-agents/), so the target is resolved
// through the route table; unknown pages fall back to the other language's home.
import Icon from './ui/Icon.astro';
import { otherLocale, toBarePath, toLocale } from '../i18n/config';
import { routeKeyFor, routePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  class?: string;
}
// Callers include a display utility (e.g. "inline-flex" or "hidden sm:inline-flex").
const { class: className = 'inline-flex' } = Astro.props;

const lang = toLocale(Astro.currentLocale);
const target = otherLocale(lang);
const t = useTranslations(lang).languageSwitcher;

const key = routeKeyFor(toBarePath(Astro.url.pathname, lang), lang) ?? 'home';
const href = routePath(target, key);
---

<a
  href={href}
  hreflang={target}
  lang={target}
  class={`items-center gap-1.5 rounded-full px-3 py-2 text-label-md text-cream/70 transition-colors duration-200 hover:text-cream ${className}`}
  aria-label={t.ariaLabel}
>
  <Icon name="language" class="size-4" />
  {target.toUpperCase()}
</a>
