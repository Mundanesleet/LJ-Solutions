---
/**
 * Shared button / button-link (Stitch styles).
 *   primary   – orange pill with a soft orange glow (main calls to action)
 *   secondary – dark grey pill (secondary actions)
 *   outline   – transparent with a hairline border
 * Renders an <a> when `href` is given, otherwise a <button>.
 */
import Icon from './ui/Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  /** Material Symbols name shown before the label. */
  icon?: string;
  /** Material Symbols name shown after the label (e.g. "arrow_forward"). */
  trailingIcon?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  trailingIcon,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2 rounded-full font-semibold tracking-[0.02em] transition-all duration-300 disabled:pointer-events-none disabled:opacity-60';

const sizes = {
  sm: 'px-5 py-2 text-label',
  md: 'px-7 py-3 text-label',
  lg: 'px-8 py-3.5 text-body leading-6',
};

const variants = {
  primary: 'bg-orange text-ink shadow-glow hover:bg-orange-dim hover:text-paper hover:shadow-glow-lg',
  secondary: 'bg-surface-2 text-cream hover:bg-surface-3',
  outline: 'border border-white/12 bg-transparent text-cream hover:border-orange hover:text-orange',
};

const iconSize = size === 'lg' ? 'size-5' : 'size-[18px]';
const classes = [base, sizes[size], variants[variant], className];
const isExternal = !!href && /^(https?:|mailto:|tel:)/.test(href);
const newTab = !!href && /^https?:/.test(href);
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      target={newTab ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      {...rest}
    >
      {icon && <Icon name={icon} class={iconSize} />}
      <span>
        <slot />
      </span>
      {trailingIcon && (
        <Icon name={trailingIcon} class:list={[iconSize, 'transition-transform duration-300 group-hover/btn:translate-x-0.5']} />
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {icon && <Icon name={icon} class={iconSize} />}
      <span>
        <slot />
      </span>
      {trailingIcon && (
        <Icon name={trailingIcon} class:list={[iconSize, 'transition-transform duration-300 group-hover/btn:translate-x-0.5']} />
      )}
    </button>
  )
}
