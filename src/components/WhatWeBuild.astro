---
import { toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).whatWeBuild;
---

<section class="border-t border-white/10 py-24 sm:py-32">
  <div class="mx-auto max-w-content px-6">
    <div class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <h2 class="font-heading text-3xl font-medium tracking-tight text-cream sm:text-4xl">{t.heading}</h2>
      <p class="max-w-sm text-mist">{t.sub}</p>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <div
        class="group flex flex-col justify-between rounded-3xl border border-white/10 bg-[#111111] p-8 lg:row-span-2 lg:p-10"
        data-reveal
      >
        <div>
          <span class="font-heading text-sm text-orange">01</span>
          <h3 class="mt-4 font-heading text-2xl font-medium text-cream">{t.software.title}</h3>
          <p class="mt-3 max-w-sm text-mist">
            {t.software.desc}
          </p>
        </div>

        <div class="mt-10 flex items-end gap-2.5" aria-hidden="true">
          {
            [42, 68, 30, 85, 52, 96, 40].map((h) => (
              <div class="w-full rounded-t-md bg-white/10 transition-colors duration-300 group-hover:bg-orange/40" style={`height:${h}px`} />
            ))
          }
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-[#111111] p-8" data-reveal>
        <span class="font-heading text-sm text-orange">02</span>
        <h3 class="mt-4 font-heading text-2xl font-medium text-cream">{t.web.title}</h3>
        <p class="mt-3 max-w-sm text-mist">
          {t.web.desc}
        </p>

        <div class="mt-8 overflow-hidden rounded-xl border border-white/10" aria-hidden="true">
          <div class="flex items-center gap-1.5 border-b border-white/10 bg-white/[0.03] px-3 py-2">
            <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
          </div>
          <div class="space-y-2 p-4">
            <div class="h-2.5 w-2/3 rounded-full bg-cream/20"></div>
            <div class="h-2 w-1/2 rounded-full bg-white/10"></div>
            <div class="mt-3 flex gap-2">
              <div class="h-10 flex-1 rounded-lg bg-orange/20"></div>
              <div class="h-10 flex-1 rounded-lg bg-white/5"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-[#111111] p-8" data-reveal>
        <span class="font-heading text-sm text-orange">03</span>
        <h3 class="mt-4 font-heading text-2xl font-medium text-cream">{t.custom.title}</h3>
        <p class="mt-3 max-w-sm text-mist">{t.custom.desc}</p>

        <div class="mt-8 flex items-center justify-center gap-3" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-orange"></span>
          <span class="h-px w-8 bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
          <span class="h-px w-8 bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
          <span class="h-px w-8 bg-white/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-orange"></span>
        </div>
      </div>
    </div>
  </div>
</section>
