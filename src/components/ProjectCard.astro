---
import type { Project } from '../data/projects';
import DashboardMockup from './mockups/DashboardMockup.astro';
import InventoryMockup from './mockups/InventoryMockup.astro';
import { localizePath, toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const mockups = { dashboard: DashboardMockup, inventory: InventoryMockup };
const Mockup = mockups[project.mockup];

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).projectCard;
const href = localizePath(lang, `/projects/${project.slug}`);

const statusClasses =
  project.statusKey === 'inDevelopment' ? 'bg-orange/15 text-orange' : 'bg-white/10 text-mist';
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-[#0f0f0f] transition-colors duration-300 hover:border-orange/40"
  data-reveal
>
  <div class="p-6 pb-0 sm:p-8 sm:pb-0">
    <div class="pointer-events-none">
      <Mockup />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <div class="flex items-center justify-between gap-3">
      <span class="text-xs font-medium uppercase tracking-wider text-mist">{project.category}</span>
      <span class={`rounded-full px-2.5 py-1 text-[11px] font-medium ${statusClasses}`}>{project.status}</span>
    </div>
    <h3 class="mt-3 font-heading text-xl font-medium text-cream sm:text-2xl">{project.title}</h3>
    <p class="mt-2 text-mist">{project.summary}</p>
    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cream transition-colors group-hover:text-orange">
      {t.cta}
      <svg
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path d="M3.5 12.5L12.5 3.5M12.5 3.5H5.5M12.5 3.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
