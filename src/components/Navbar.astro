---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getNavLinks } from '../data/site';
import { localizePath, toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).nav;
const navLinks = getNavLinks(lang);
const homeHref = localizePath(lang, '/#top');
const contactHref = localizePath(lang, '/#contact');
---

<header class="fixed inset-x-0 top-4 z-50 px-4 sm:top-6 sm:px-6">
  <div
    class="mx-auto flex max-w-content items-center justify-between gap-4 rounded-full border border-white/10 bg-ink/95 px-3 py-2.5 shadow-[0_8px_30px_rgba(0,0,0,0.3)] backdrop-blur-md sm:px-4"
  >
    <a href={homeHref} class="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-3" aria-label={t.homeAria}>
      <Logo class="h-8 w-8 shrink-0" />
      <span class="font-heading text-[15px] font-medium tracking-tight text-cream">LJ Solutions</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-mist transition-colors duration-200 hover:text-cream"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher class="hidden sm:inline-flex" />

      <a
        href={contactHref}
        class="hidden rounded-full bg-cream px-5 py-2.5 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-orange sm:inline-flex"
      >
        {t.talk}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-cream md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.openMenu}
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
      >
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M2.5 5.5H17.5M2.5 10H17.5M2.5 14.5H17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mx-auto mt-2 hidden max-w-content flex-col gap-1 rounded-3xl border border-white/10 bg-ink/95 p-3 backdrop-blur-md md:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu-link rounded-2xl px-4 py-3 text-base font-medium text-cream transition-colors hover:bg-white/5"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={contactHref}
      class="mobile-menu-link mt-1 rounded-2xl bg-orange px-4 py-3 text-center text-base font-semibold text-ink"
    >
      {t.talk}
    </a>
    <div class="mt-1 border-t border-white/10 pt-2">
      <LanguageSwitcher class="inline-flex w-full justify-center border-none py-3" />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const openLabel = toggle?.dataset.openLabel ?? 'Open menu';
  const closeLabel = toggle?.dataset.closeLabel ?? 'Close menu';

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', openLabel);
  }

  function openMenu() {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', closeLabel);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  menu?.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
