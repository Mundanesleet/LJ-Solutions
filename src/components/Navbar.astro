---
/**
 * Site header, shared by every page (Stitch "TOP NAVIGATION").
 * Order: logo · Inicio · Servicios ▾ · Nosotros · Contacto · Hablemos.
 *
 * The Servicios menu opens on hover (fine pointers), click/tap, and keyboard
 * (Enter/Space/↓ open, ↑/↓ move, Esc closes and returns focus). The header has no
 * backdrop blur on purpose: it caused a scroll glitch on iOS Safari.
 */
import Icon from './ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getWhatsAppLink } from '../data/site';
import { toBarePath, toLocale } from '../i18n/config';
import { routeKeyFor, routePath, SERVICE_ROUTES, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
const current = routeKeyFor(toBarePath(Astro.url.pathname, lang), lang);
const whatsappHref = getWhatsAppLink(lang);

const SERVICE_ICONS: Record<(typeof SERVICE_ROUTES)[number], string> = {
  webDev: 'laptop_mac',
  aiAgents: 'smart_toy',
  management: 'analytics',
};
const services = SERVICE_ROUTES.map((key) => ({
  key,
  href: routePath(lang, key),
  label: t.services[key],
  icon: SERVICE_ICONS[key],
  active: current === key,
}));
const inServices = services.some((s) => s.active);

const links: { key: RouteKey; label: string }[] = [
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
];

const item = 'whitespace-nowrap rounded-full px-3 py-1.5 text-label transition-colors duration-200 lg:px-4';
const idle = 'text-cream/70 hover:text-cream';
const active = 'bg-surface-2 font-bold text-orange';
---

<header class="site-header fixed inset-x-0 top-0 z-50 bg-surface/95 shadow-[0_1px_8px_rgba(0,0,0,0.25)]" data-header>
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href={routePath(lang, 'home')} class="shrink-0 rounded-md text-h2 tracking-tight" aria-label={t.nav.homeAria}>
      <span class="text-cream">LJ</span> <span class="text-orange">Solutions</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-1 md:flex lg:gap-2" aria-label={t.nav.primaryAria}>
      <a
        href={routePath(lang, 'home')}
        class:list={[item, current === 'home' ? active : idle]}
        aria-current={current === 'home' ? 'page' : undefined}>{t.nav.home}</a
      >

      <div class="relative" data-dropdown>
        <button
          type="button"
          class:list={[item, 'inline-flex items-center gap-1', inServices ? active : idle]}
          aria-expanded="false"
          aria-controls="services-menu"
          data-dropdown-trigger
        >
          {t.nav.services}
          <Icon name="expand_more" class="size-[18px] transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" />
        </button>

        <div id="services-menu" class="absolute left-0 top-full z-50 hidden w-60 pt-2" data-dropdown-menu>
          <ul class="flex flex-col gap-1 rounded-xl border border-white/5 bg-surface-2 p-2 shadow-2xl">
            {
              services.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class:list={[
                      'flex items-center gap-2.5 rounded-lg px-4 py-2.5 text-body-sm transition-colors',
                      s.active ? 'bg-surface-3 font-semibold text-cream' : 'text-cream/75 hover:bg-surface-3 hover:text-cream',
                    ]}
                    aria-current={s.active ? 'page' : undefined}
                    data-dropdown-item
                  >
                    <Icon name={s.icon} class="size-[18px] text-orange" />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        links.map((l) => (
          <a
            href={routePath(lang, l.key)}
            class:list={[item, current === l.key ? active : idle]}
            aria-current={current === l.key ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <LanguageSwitcher class="hidden lg:inline-flex" />
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 whitespace-nowrap rounded-full bg-orange px-5 py-2 text-label text-ink shadow-glow transition-all hover:bg-orange-dim hover:text-paper sm:inline-flex"
      >
        <Icon name="chat" class="size-[18px]" />
        {t.nav.talk}
      </a>

      <button
        type="button"
        class="-mr-2 inline-flex size-11 items-center justify-center rounded-full text-cream md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
        data-open-label={t.nav.openMenu}
        data-close-label={t.nav.closeMenu}
        data-menu-toggle
      >
        <Icon name="menu" class="size-6 [[aria-expanded=true]>&]:hidden" />
        <Icon name="close" class="hidden size-6 [[aria-expanded=true]>&]:block" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden h-[calc(100svh-5rem)] overflow-y-auto overscroll-contain border-t border-white/5 bg-surface md:hidden"
    data-mobile-menu
  >
    <nav class="container-page flex flex-col gap-1 py-4" aria-label={t.nav.primaryAria}>
      <a
        href={routePath(lang, 'home')}
        class:list={['rounded-xl px-4 py-3 text-body-lg font-semibold', current === 'home' ? 'bg-surface-2 text-orange' : 'text-cream']}
        aria-current={current === 'home' ? 'page' : undefined}>{t.nav.home}</a
      >

      <button
        type="button"
        class:list={[
          'flex items-center justify-between rounded-xl px-4 py-3 text-left text-body-lg font-semibold',
          inServices ? 'text-orange' : 'text-cream',
        ]}
        aria-expanded={inServices ? 'true' : 'false'}
        aria-controls="mobile-services"
        data-mobile-services
      >
        {t.nav.services}
        <Icon name="expand_more" class="size-6 transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" />
      </button>
      <ul id="mobile-services" class:list={['flex-col gap-1 pb-2 pl-3', inServices ? 'flex' : 'hidden']}>
        {
          services.map((s) => (
            <li>
              <a
                href={s.href}
                class:list={[
                  'flex items-center gap-3 rounded-xl px-4 py-3 text-body',
                  s.active ? 'bg-surface-2 font-semibold text-cream' : 'text-cream/75',
                ]}
                aria-current={s.active ? 'page' : undefined}
              >
                <Icon name={s.icon} class="size-5 text-orange" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        links.map((l) => (
          <a
            href={routePath(lang, l.key)}
            class:list={[
              'rounded-xl px-4 py-3 text-body-lg font-semibold',
              current === l.key ? 'bg-surface-2 text-orange' : 'text-cream',
            ]}
            aria-current={current === l.key ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-full bg-orange px-6 py-3.5 text-body font-semibold text-ink shadow-glow"
      >
        <Icon name="chat" class="size-5" />
        {t.nav.talk}
      </a>
      <div class="mt-2 flex justify-center border-t border-white/5 pt-3">
        <LanguageSwitcher class="inline-flex" />
      </div>
    </nav>
  </div>
</header>

<script>
  // --- Desktop "Servicios" dropdown -------------------------------------------
  const dropdown = document.querySelector<HTMLElement>('[data-dropdown]');
  const trigger = dropdown?.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
  const menu = dropdown?.querySelector<HTMLElement>('[data-dropdown-menu]');

  if (dropdown && trigger && menu) {
    const items = () => [...menu.querySelectorAll<HTMLAnchorElement>('[data-dropdown-item]')];
    let closeTimer: number | undefined;
    // A click right after hover-opening must not close the menu again.
    let openedByHover = false;

    const setOpen = (open: boolean) => {
      window.clearTimeout(closeTimer);
      if (!open) openedByHover = false;
      trigger.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
    };
    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => {
      if (openedByHover) {
        openedByHover = false;
        return;
      }
      setOpen(!isOpen());
    });

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setOpen(true);
        items()[0]?.focus();
      }
    });

    menu.addEventListener('keydown', (e) => {
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        list[(i + 1) % list.length]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (i <= 0) trigger.focus();
        else list[i - 1]?.focus();
      } else if (e.key === 'Home') {
        e.preventDefault();
        list[0]?.focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        list[list.length - 1]?.focus();
      }
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        trigger.focus();
      }
    });

    // Close when focus leaves the dropdown (Tab past the last item).
    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget as Node)) setOpen(false);
    });

    // Hover opens on mouse/trackpad; a short delay forgives diagonal movement.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      dropdown.addEventListener('mouseenter', () => {
        if (!isOpen()) {
          setOpen(true);
          openedByHover = true;
        } else window.clearTimeout(closeTimer);
      });
      dropdown.addEventListener('mouseleave', () => {
        closeTimer = window.setTimeout(() => setOpen(false), 160);
      });
    }

    document.addEventListener('click', (e) => {
      if (isOpen() && !dropdown.contains(e.target as Node)) setOpen(false);
    });
  }

  // --- Mobile menu ------------------------------------------------------------
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const servicesToggle = document.querySelector<HTMLButtonElement>('[data-mobile-services]');
  const servicesList = document.getElementById('mobile-services');

  if (toggle && mobileMenu) {
    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
      mobileMenu.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        toggle.focus();
      }
    });

    // Leaving the mobile breakpoint with the menu open would strand it.
    window.matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setMenu(false));
  }

  servicesToggle?.addEventListener('click', () => {
    const open = servicesToggle.getAttribute('aria-expanded') !== 'true';
    servicesToggle.setAttribute('aria-expanded', String(open));
    servicesList?.classList.toggle('hidden', !open);
    servicesList?.classList.toggle('flex', open);
  });
</script>
