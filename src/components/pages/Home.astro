---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../Hero.astro';
import HomeSolutions from '../home/HomeSolutions.astro';
import HomeWhy from '../home/HomeWhy.astro';
import HomeProcess from '../home/HomeProcess.astro';
import WhatsAppCta from '../ui/WhatsAppCta.astro';
import SplashIntro from '../SplashIntro.astro';
import SculptureStage from '../SculptureStage.astro';
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations(toLocale(Astro.currentLocale)).home;
---

<PageLayout>
  <script is:inline slot="head">
    // Decide intro + hero entrance before first paint, so nothing flashes.
    (function () {
      var root = document.documentElement;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('motion-ok', 'hero-anim');
      try {
        if (!location.hash && !sessionStorage.getItem('lj-intro')) root.classList.add('intro-on');
      } catch (e) {}
      // Fail-safe: never leave the page hidden if the animation bundle fails to load.
      setTimeout(function () {
        root.classList.remove('intro-on', 'hero-anim');
      }, 7000);
    })();
  </script>

  <Fragment slot="before">
    <SplashIntro />
    <SculptureStage />
  </Fragment>

  <Hero />
  <HomeSolutions />
  <HomeWhy />
  <HomeProcess />
  <WhatsAppCta title={t.cta.title} sub={t.cta.sub} />
</PageLayout>
