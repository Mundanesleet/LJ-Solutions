---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import ProjectCard from '../ProjectCard.astro';
import { getProjects } from '../../data/projects';
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
const projects = getProjects(lang);
---

<BaseLayout title={t.seo.projectsTitle} description={t.seo.projectsDescription}>
  <Navbar />
  <main class="pb-24 pt-36 sm:pt-44">
    <div class="mx-auto max-w-content px-6">
      <h1 class="font-heading text-4xl font-medium tracking-tight text-cream sm:text-5xl" data-reveal>
        {t.projectsPage.title}
      </h1>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-mist" data-reveal>
        {t.projectsSection.sub}
      </p>

      <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
