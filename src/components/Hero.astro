---
import Button from './Button.astro';
import HeroMockup from './mockups/HeroMockup.astro';
import { toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).hero;
---

<section id="top" class="relative overflow-hidden pb-20 pt-36 sm:pb-28 sm:pt-44 lg:pt-48">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07]"
    style="background-image: linear-gradient(to right, #F5F0E8 1px, transparent 1px), linear-gradient(to bottom, #F5F0E8 1px, transparent 1px); background-size: 64px 64px;"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-content px-6">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/10 px-3.5 py-1.5 text-xs font-medium uppercase tracking-wider text-mist" data-reveal>
          <span class="h-1.5 w-1.5 rounded-full bg-orange"></span>
          {t.eyebrow}
        </p>

        <h1 class="mt-6 font-heading text-[2.75rem] font-medium leading-[1.05] tracking-tight text-cream sm:text-6xl lg:text-[4.25rem]" data-reveal>
          {t.headlinePre}<br />
          <span class="text-orange">{t.headlineHighlight}</span> {t.headlinePost}
        </h1>

        <p class="mt-7 max-w-lg text-lg leading-relaxed text-mist" data-reveal>
          {t.sub}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal>
          <Button href="#solutions" variant="primary">{t.cta1}</Button>
          <Button href="#contact" variant="ghost">{t.cta2}</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <HeroMockup />
      </div>
    </div>
  </div>
</section>
