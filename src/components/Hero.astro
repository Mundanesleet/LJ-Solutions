---
import Button from './Button.astro';
import { getWhatsAppLink } from '../data/site';
import { toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).hero;
const whatsappHref = getWhatsAppLink(lang);

// Each word sits in its own mask so the headline can rise in word by word
// while still wrapping naturally at every breakpoint.
const words = [
  ...t.headlinePre.split(' ').map((w) => ({ w, hl: false })),
  ...t.headlineHighlight.split(' ').map((w) => ({ w, hl: true })),
  ...t.headlinePost.split(' ').filter(Boolean).map((w) => ({ w, hl: false })),
];
---

<!--
  Stitch "HERO SECTION". The sculpture is not part of this section: it lives on the
  page-level stage (SculptureStage.astro, z -10). data-sculpture-scene="hero" tells
  the director this is where the figure starts. The section paints its background
  and glows on negative layers *behind* the stage, so it must not create a stacking
  context (no z-index / isolation here).
-->
<section
  id="top"
  class="hero relative flex min-h-svh items-end overflow-hidden lg:items-center"
  data-hero
  data-sculpture-scene="hero"
>
  <div class="absolute inset-0 -z-30 bg-surface" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--a -z-20" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b -z-20" aria-hidden="true"></div>

  <div class="container-page grid grid-cols-1 pb-16 pt-40 sm:pb-24 lg:grid-cols-12 lg:py-40" data-hero-copy>
    <div class="flex flex-col gap-6 lg:col-span-6">
      <h1 class="hero__title text-display-sm text-cream sm:text-display">
        {
          words.map(({ w, hl }) => (
            <>
              <span class="hero__mask">
                <span class:list={['hero__word', hl && 'text-orange']} data-hero-word>
                  {w}
                </span>
              </span>{' '}
            </>
          ))
        }
      </h1>

      <p class="max-w-xl text-body-lg text-cream/75" data-hero-fade>
        {t.sub}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2 sm:gap-4" data-hero-fade>
        <Button href={whatsappHref} icon="chat">{t.cta}</Button>
        <Button href="#soluciones" variant="secondary" trailingIcon="arrow_forward">{t.ctaSecondary}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Masks clip the rising words; the padding keeps descenders from being cut. */
  .hero__mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    vertical-align: top;
  }

  .hero__word {
    display: inline-block;
  }

  /* Ambient incandescent backdrops (Stitch). */
  .hero__glow {
    position: absolute;
    pointer-events: none;
    border-radius: 9999px;
  }

  .hero__glow--a {
    top: -10rem;
    right: 25%;
    width: 34rem;
    height: 34rem;
    background: rgb(255 77 0 / 0.15);
    filter: blur(140px);
  }

  .hero__glow--b {
    top: 33%;
    left: -8rem;
    width: 26rem;
    height: 26rem;
    background: rgb(255 77 0 / 0.1);
    filter: blur(120px);
  }

  /* Pre-animation state, only set when motion is allowed and JS is running. */
  :global(html.hero-anim) [data-hero-word] {
    transform: translateY(105%);
  }

  :global(html.hero-anim) [data-hero-fade] {
    opacity: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const release = () => root.classList.remove('hero-anim');

  if (!hero) {
    release();
  } else {
    const words = hero.querySelectorAll<HTMLElement>('[data-hero-word]');
    const fades = hero.querySelectorAll<HTMLElement>('[data-hero-fade]');
    const copy = hero.querySelector<HTMLElement>('[data-hero-copy]')!;

    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // --- Entrance (the sculpture's entrance runs on the same cue, from the stage) --
      const enter = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });
      enter
        // y: 0 discards the px offset GSAP would otherwise inherit from the CSS pre-state.
        .fromTo(words, { y: 0, yPercent: 105 }, { y: 0, yPercent: 0, duration: 1.2, stagger: 0.06 }, 0.1)
        .fromTo(fades, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 1, stagger: 0.1 }, 0.5);

      const play = () => {
        release();
        enter.play();
      };

      if (root.classList.contains('intro-on')) {
        window.addEventListener('lj:intro-reveal', play, { once: true });
      } else {
        play();
      }

      // --- Scroll: the copy lifts away as the sculpture takes over -------------
      gsap.to(copy, {
        y: -90,
        opacity: 0,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom 25%', scrub: 0.6 },
      });
    });

    mm.add('(prefers-reduced-motion: reduce)', release);
  }
</script>
