---
import DashboardMockup from './DashboardMockup.astro';
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).heroMockup;
---

<div class="relative mx-auto w-full max-w-md pt-10 sm:pt-14 lg:mx-0" data-reveal>
  <div class="absolute -inset-x-6 -top-2 -bottom-10 -z-10 rounded-[3rem] bg-orange/10 blur-3xl"></div>

  <DashboardMockup class="shadow-[0_30px_80px_-20px_rgba(0,0,0,0.6)]" />

  <div
    class="absolute -left-6 -top-10 w-40 rounded-2xl border border-white/10 bg-cream p-4 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] sm:-left-10 sm:-top-12 sm:w-44"
  >
    <p class="font-heading text-2xl font-medium text-ink">+32%</p>
    <p class="mt-1 text-[11px] leading-snug text-ink/60">{t.badgeCaption}</p>
  </div>

  <div
    class="absolute -bottom-6 -right-4 flex items-center gap-2 rounded-full border border-white/10 bg-ink px-4 py-2.5 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.6)] sm:-right-8"
  >
    <span class="h-2 w-2 rounded-full bg-orange"></span>
    <span class="text-xs font-medium text-cream">{t.synced}</span>
  </div>
</div>
