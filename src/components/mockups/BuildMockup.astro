---
// Abstract composition representing custom software being assembled
// around a specific process — intentionally not a literal screenshot.
// The pseudo-code stays in English regardless of locale, same as real code would.
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).buildMockup;
---

<div class={`rounded-3xl border border-white/10 bg-[#111111] p-5 sm:p-6 font-mono ${className}`} aria-hidden="true">
  <div class="flex items-center gap-2">
    <span class="h-2 w-2 rounded-full bg-orange"></span>
    <span class="text-xs uppercase tracking-wider text-mist">process.build</span>
  </div>

  <pre class="mt-4 overflow-x-auto text-[13px] leading-7"><code
    ><span class="text-mist">01</span>  <span class="text-cream">workflow</span><span class="text-mist">.</span><span class="text-orange">define</span><span class="text-mist">(</span><span class="text-cream/70">"your_process"</span><span class="text-mist">)</span>
<span class="text-mist">02</span>    <span class="text-mist">.</span><span class="text-orange">step</span><span class="text-mist">(</span><span class="text-cream/70">"understand"</span><span class="text-mist">)</span>
<span class="text-mist">03</span>    <span class="text-mist">.</span><span class="text-orange">step</span><span class="text-mist">(</span><span class="text-cream/70">"design"</span><span class="text-mist">)</span>
<span class="text-mist">04</span>    <span class="text-mist">.</span><span class="text-orange">step</span><span class="text-mist">(</span><span class="text-cream/70">"build_and_test"</span><span class="text-mist">)</span>
<span class="text-mist">05</span>    <span class="text-mist">.</span><span class="text-orange">deploy</span><span class="text-mist">()</span></code></pre>

  <div class="mt-5 flex items-center gap-2 border-t border-white/10 pt-4">
    <span class="h-1.5 w-1.5 rounded-full bg-orange"></span>
    <p class="text-xs text-mist">{t.caption}</p>
  </div>
</div>
