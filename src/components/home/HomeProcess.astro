---
/** Home · "Nuestro proceso": four numbered steps. */
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations(toLocale(Astro.currentLocale)).home.process;
---

<section class="bg-ink py-16 md:py-24" aria-labelledby="process-title">
  <div class="container-page">
    <SectionHeader id="process-title" title={t.title} sub={t.sub} class="mb-10" />

    <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.steps.map((step, i) => (
          <li
            class="flex flex-col rounded-xl border border-surface-2/60 bg-surface-low p-5"
            data-reveal
            style={`transition-delay:${i * 80}ms`}
          >
            <div class="mb-3 flex items-baseline justify-between">
              <span class="text-h1 font-extrabold text-orange/30" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Icon name={step.icon} class="size-5 text-orange" />
            </div>
            <h3 class="mb-1 text-h3 text-cream">
              <span class="sr-only">{i + 1}. </span>
              {step.title}
            </h3>
            <p class="text-body-sm text-cream/70">{step.desc}</p>
            <span class="mt-auto block pt-5" aria-hidden="true">
              <span class="block h-0.5 w-full bg-orange" />
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
