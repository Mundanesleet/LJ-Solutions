---
/** Home · "¿Por qué elegir LJ Solutions?": editorial image + three benefits. */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { toLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import whyImg from '../../assets/home/why-lj.jpg';

const t = useTranslations(toLocale(Astro.currentLocale)).home.why;
---

<section class="bg-surface py-16 md:py-24" aria-labelledby="why-title">
  <div class="container-page grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="relative overflow-hidden rounded-3xl bg-surface-low shadow-xl lg:col-span-6" data-reveal>
      <Image
        src={whyImg}
        alt={t.imageAlt}
        widths={[480, 720, 1100]}
        sizes="(min-width: 1024px) 560px, 100vw"
        class="h-72 w-full object-cover sm:h-96 lg:h-[460px]"
        loading="lazy"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent" aria-hidden="true">
      </div>
    </div>

    <div class="flex flex-col gap-6 lg:col-span-6">
      <div class="flex flex-col gap-3" data-reveal>
        <h2 id="why-title" class="text-h1-sm text-cream md:text-h1">
          {t.titlePre} <span class="text-orange">{t.titleHighlight}</span>{t.titlePost}
        </h2>
        <p class="text-body-lg text-cream/70">{t.body}</p>
      </div>

      <ul class="flex flex-col gap-3">
        {
          t.benefits.map((b, i) => (
            <li
              class="flex items-start gap-4 rounded-2xl bg-surface-low p-4 transition-colors hover:bg-surface-1"
              data-reveal
              style={`transition-delay:${i * 80}ms`}
            >
              <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-surface-2 text-orange">
                <Icon name={b.icon} class="size-6" />
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="text-h3 text-cream">{b.title}</h3>
                <p class="text-body text-cream/70">{b.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
