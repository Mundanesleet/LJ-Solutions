---
import { CONTACT_EMAIL, FORM_ENDPOINT, getSocialLinks } from '../data/site';
import { toLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang).contact;
const socialLinks = getSocialLinks(lang);
---

<section id="contact" class="border-t border-white/10 py-24 sm:py-32">
  <div class="mx-auto max-w-content px-6">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="font-heading text-3xl font-medium leading-[1.15] tracking-tight text-cream sm:text-4xl">
          {t.heading}
        </h2>
        <p class="mt-5 max-w-sm text-lg leading-relaxed text-mist">
          {t.sub}
        </p>

        <div class="mt-10 flex flex-col gap-3">
          <a
            href={socialLinks.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between rounded-2xl border border-white/10 px-5 py-4 transition-colors hover:border-orange/40"
          >
            <span class="flex items-center gap-3">
              <span class="text-sm font-medium text-cream">{t.whatsapp}</span>
            </span>
            <svg class="h-3.5 w-3.5 text-mist transition-colors group-hover:text-orange" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 12.5L12.5 3.5M12.5 3.5H5.5M12.5 3.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="group flex items-center justify-between rounded-2xl border border-white/10 px-5 py-4 transition-colors hover:border-orange/40"
          >
            <span class="text-sm font-medium text-cream">{CONTACT_EMAIL}</span>
            <svg class="h-3.5 w-3.5 text-mist transition-colors group-hover:text-orange" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 12.5L12.5 3.5M12.5 3.5H5.5M12.5 3.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <form
          id="contact-form"
          data-endpoint={FORM_ENDPOINT}
          data-email={CONTACT_EMAIL}
          data-subject={t.mailtoSubject}
          data-sending={t.statusSending}
          data-success={t.statusSuccess}
          data-error={t.statusError}
          data-mailto-status={t.statusMailto}
          class="flex flex-col gap-5"
          novalidate
        >
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-xs font-medium uppercase tracking-wider text-mist">{t.formName}</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-cream placeholder:text-mist/50 focus:border-orange focus:outline-none"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label for="business" class="text-xs font-medium uppercase tracking-wider text-mist">{t.formBusiness}</label>
              <input
                type="text"
                id="business"
                name="business"
                autocomplete="organization"
                class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-cream placeholder:text-mist/50 focus:border-orange focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="email" class="text-xs font-medium uppercase tracking-wider text-mist">{t.formEmail}</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-cream placeholder:text-mist/50 focus:border-orange focus:outline-none"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label for="whatsapp" class="text-xs font-medium uppercase tracking-wider text-mist">{t.formWhatsapp}</label>
              <input
                type="tel"
                id="whatsapp"
                name="whatsapp"
                autocomplete="tel"
                class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-cream placeholder:text-mist/50 focus:border-orange focus:outline-none"
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-xs font-medium uppercase tracking-wider text-mist">{t.formMessage}</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="resize-none rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-cream placeholder:text-mist/50 focus:border-orange focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex w-fit items-center gap-2.5 rounded-full bg-orange px-6 py-3.5 text-sm font-semibold text-ink transition-colors duration-300 hover:bg-cream"
          >
            {t.submit}
          </button>

          <p id="form-status" class="text-sm text-mist" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email;
    const data = Object.fromEntries(new FormData(form).entries());

    if (endpoint) {
      status.textContent = form.dataset.sending ?? 'Sending...';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('Request failed');
        status.textContent = form.dataset.success ?? '';
        form.reset();
      } catch {
        status.textContent = form.dataset.error ?? '';
      }
      return;
    }

    // No form backend connected yet: fall back to a pre-filled email draft.
    const body = [
      `Name: ${data.name ?? ''}`,
      `Business: ${data.business ?? ''}`,
      `Email: ${data.email ?? ''}`,
      `WhatsApp: ${data.whatsapp ?? ''}`,
      '',
      String(data.message ?? ''),
    ].join('\n');
    const subject = form.dataset.subject ?? 'New inquiry — LJ Solutions';
    const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
    status.textContent = form.dataset.mailtoStatus ?? '';
  });
</script>
